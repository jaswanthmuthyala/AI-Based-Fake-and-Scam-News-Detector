# MongoDB Atlas Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fake_scam_detector

# Authentication and Session Security
# Use a random secret key at least 32 characters long
SESSION_SECRET=generate_a_secure_random_key_with_at_least_32_characters

# Frontend Origin for CORS (comma-separated list of allowed origins)
# For Render deployment, include your deployed Vercel domain and localhost for dev
FRONTEND_ORIGIN=https://ai-based-fake-and-scam-news-detecto.vercel.app,http://localhost:5173

# Environment
# Set to 'production' on Render to enforce Secure + SameSite=None cookies for cross-origin HTTPS
# Set to 'development' on localhost
ENVIRONMENT=development
